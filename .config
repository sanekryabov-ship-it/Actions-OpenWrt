CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
# Исправленная и дополненная строка для точного выбора устройства ASUS RT-AC57U v1:
CONFIG_TARGET_DEVICE_ramips_mt7621_DEVICE_asus_rt-ac57u-v1=y
CONFIG_TARGET_ramips_mt7621_DEVICE_asus_rt-ac57u-v1=y

CONFIG_HAS_SUBTARGET_ARCH=y
CONFIG_TARGET_BOARD="ramips"
CONFIG_TARGET_SUBTARGET="mt7621"
CONFIG_TARGET_ARCH_PACKAGES="mipsel_24kc"
CONFIG_ARCH="mipsel"

# Принудительно отключаем сборку лишних профилей, чтобы не тратить место
# CONFIG_TARGET_MULTI_PROFILE is not set
# CONFIG_TARGET_PER_DEVICE_ROOTFS is not set

# Веб-интерфейс
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_LUCI_LANG_ru=y

# Базовые сетевые модули ядра
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nfnetlink-queue=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_ca-certificates=y

# Драйверы USB (ДОПОЛНЕНО)
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

# Поддержка файловой системы ext4 и автомонтирования (ДОБАВЛЕНО)
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y

# Сам сервер ksmbd и LuCI-панель управления на русском (ДОБАВЛЕНО)
CONFIG_PACKAGE_ksmbd-server=y
CONFIG_PACKAGE_ksmbd-utils=y
CONFIG_PACKAGE_luci-app-ksmbd=y
CONFIG_PACKAGE_luci-i18n-ksmbd-ru=y

# Легковесный UPnP/DLNA мультимедиа сервер (MiniDLNA)
CONFIG_PACKAGE_minidlna=y
CONFIG_PACKAGE_luci-app-minidlna=y
CONFIG_PACKAGE_luci-i18n-minidlna-ru=y
