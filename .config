# Архитектура и процессор
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y

# Точный профиль вашего роутера (в OpenWrt v1 идет под этим именем)
CONFIG_TARGET_DEVICE_ramips_mt7621_DEVICE_asus_rt-ac1200gu=y

# Включаем веб-интерфейс LuCI и перевод
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_LUCI_LANG_ru=y

# Базовая поддержка USB и файловых систем (раз у роутера есть USB)
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
